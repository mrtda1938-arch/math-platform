<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>الفصل الأول - الثالث المتوسط</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f1f6ff;
      color: #123b7a;
    }

    header {
      background: linear-gradient(135deg, #0645a5, #0878d1);
      color: white;
      text-align: center;
      padding: 35px 20px;
    }

    header h1 {
      margin: 0 0 10px;
      font-size: 32px;
    }

    header p {
      margin: 0;
      font-size: 20px;
    }

    .container {
      max-width: 900px;
      margin: 25px auto;
      padding: 0 20px;
    }

    .welcome {
      background: white;
      border-radius: 18px;
      padding: 25px;
      text-align: center;
      box-shadow: 0 4px 15px rgba(0,0,0,0.10);
      margin-bottom: 25px;
    }

    .welcome h2 {
      color: #0645a5;
      margin-top: 0;
    }

    .lessons {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }

    .card {
      background: white;
      border-radius: 18px;
      padding: 25px;
      text-align: center;
      box-shadow: 0 4px 15px rgba(0,0,0,0.10);
    }

    .card h3 {
      color: #0645a5;
      font-size: 22px;
      margin-top: 0;
    }

    .card p {
      color: #555;
      line-height: 1.7;
    }

    .button {
      display: inline-block;
      background: #0866c6;
      color: white;
      text-decoration: none;
      padding: 12px 28px;
      border-radius: 12px;
      font-size: 18px;
      margin-top: 10px;
    }

    .back {
      text-align: center;
      margin: 30px 0;
    }

    footer {
      background: #0645a5;
      color: white;
      text-align: center;
      padding: 20px;
      margin-top: 30px;
    }
  </style>
</head>

<body>

  <header>
    <h1>أساسيات الرياضيات</h1>
    <p>الصف الثالث المتوسط</p>
  </header>

  <main class="container">

    <section class="welcome">
      <h2>الفصل الأول</h2>
      <p>دروس وملخصات وتمارين الرياضيات</p>
      <p>المدرس مرتضى الجابري</p>
    </section>

    <section class="lessons">

      <div class="card">
        <h3>الدرس الأول</h3>
        <p>شرح الدرس الأول</p>
        <a class="button" href="#">الدخول</a>
      </div>

      <div class="card">
        <h3>الدرس الثاني</h3>
        <p>شرح الدرس الثاني</p>
        <a class="button" href="#">الدخول</a>
      </div>

      <div class="card">
        <h3>الدرس الثالث</h3>
        <p>شرح الدرس الثالث</p>
        <a class="button" href="#">الدخول</a>
      </div>

      <div class="card">
        <h3>التمارين</h3>
        <p>تمارين وأسئلة الفصل الأول</p>
        <a class="button" href="#">الدخول</a>
      </div>

      <div class="card">
        <h3>الملخص</h3>
        <p>ملخص الفصل الأول</p>
        <a class="button" href="#">الدخول</a>
      </div>

    </section>

    <div class="back">
      <a class="button" href="third.html">
        العودة إلى الثالث المتوسط
      </a>
    </div>

  </main>

  <footer>
    منصة مرتضى الجابري للتدريس
  </footer>

</body>
</html>
